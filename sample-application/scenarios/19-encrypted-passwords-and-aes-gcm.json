{
  "name": "19 Enterprise AES-GCM Encrypted Password & Secret Suite",
  "platform": "Web, Mobile, Desktop, API",
  "description": "Demonstrates AES-GCM 256-bit password protection across Web, Mobile, Desktop, and REST API using {{PASSWORD}} placeholder and enterEncryptedPassword action with zero plaintext leakage in logs.",
  "data": {
    "baseUrl": "http://127.0.0.1:3100",
    "apiUrl": "http://127.0.0.1:3100/api/auth/login",
    "adminEmail": "admin@campus.test",
    "PASSWORD": "ENC:GCM:XkRZ7D2EG+PXjIgS:Bi6+R8RJZxZNS5dHHwb9bfwdNAqr5qc1ZQELqQA="
  },
  "locators": {
    "txt_Email": "#email",
    "txt_Password": "#password",
    "btn_Login": "#btn-login",
    "lbl_UserBadge": "#current-user-badge",
    "btn_Logout": "#btn-logout"
  },
  "testData": {
    "credentialAccounts": [
      {
        "role": "Administrator",
        "email": "admin@campus.test",
        "password": "ENC:GCM:XkRZ7D2EG+PXjIgS:Bi6+R8RJZxZNS5dHHwb9bfwdNAqr5qc1ZQELqQA=",
        "expectedName": "Administrator"
      },
      {
        "role": "Teacher",
        "email": "teacher@campus.test",
        "password": "ENC:GCM:XkRZ7D2EG+PXjIgS:Bi6+R8RJZxZNS5dHHwb9bfwdNAqr5qc1ZQELqQA=",
        "expectedName": "Prof. Alan Turing"
      },
      {
        "role": "Student",
        "email": "student1@campus.test",
        "password": "ENC:GCM:XkRZ7D2EG+PXjIgS:Bi6+R8RJZxZNS5dHHwb9bfwdNAqr5qc1ZQELqQA=",
        "expectedName": "Aarav Sharma"
      }
    ]
  },
  "testCases": [
    {
      "testCaseId": "TC-SEC-01",
      "Case": "Web Login with AES-GCM Encrypted Password (enterEncryptedPassword)",
      "isRun": true,
      "hardStop": false,
      "tagNames": ["security", "web", "aes-gcm", "encryption", "password"],
      "testSteps": [
        {
          "steps": "Open the CampusFlow web application",
          "action": "enterurl",
          "locatorType": "NA",
          "locatorTypeValue": "NA",
          "value": "http://127.0.0.1:3100",
          "isRun": true
        },
        {
          "steps": "Wait for login page to load",
          "action": "sleep",
          "value": "300",
          "isRun": true
        },
        {
          "steps": "Enter admin email address",
          "action": "sendkeys",
          "locatorType": "css",
          "locatorTypeValue": "#email",
          "value": "admin@campus.test",
          "isRun": true
        },
        {
          "steps": "Decrypt AES-GCM password and enter securely without plaintext logging",
          "action": "enterEncryptedPassword",
          "locatorType": "css",
          "locatorTypeValue": "#password",
          "value": "{{PASSWORD}}",
          "isRun": true
        },
        {
          "steps": "Click the Sign In button",
          "action": "click",
          "locatorType": "css",
          "locatorTypeValue": "#btn-login",
          "isRun": true
        },
        {
          "steps": "Wait for authentication session to initialize",
          "action": "sleep",
          "value": "500",
          "isRun": true
        },
        {
          "steps": "Validate that the admin badge is visible",
          "action": "validatetext",
          "locatorType": "css",
          "locatorTypeValue": "#current-user-badge",
          "value": "Administrator",
          "isRun": true
        }
      ]
    },
    {
      "testCaseId": "TC-SEC-02",
      "Case": "REST API Authentication with AES-GCM Decryption (api-POST)",
      "isRun": true,
      "hardStop": false,
      "tagNames": ["security", "api", "aes-gcm", "token-chaining"],
      "testSteps": [
        {
          "steps": "Execute REST API login with {{PASSWORD}} decrypted on network dispatch",
          "action": "api-POST",
          "locatorType": "NA",
          "locatorTypeValue": "NA",
          "value": "http://127.0.0.1:3100/api/auth/login",
          "actualValue": "{\"Url\":\"http://127.0.0.1:3100/api/auth/login\",\"Headers\":{\"Content-Type\":\"application/json\"},\"Body\":{\"email\":\"admin@campus.test\",\"password\":\"{{PASSWORD}}\"}}",
          "isRun": true
        },
        {
          "steps": "Verify API login returned HTTP 200 OK with session token",
          "action": "validatetext",
          "locatorType": "NA",
          "locatorTypeValue": "NA",
          "value": "HTTP 200",
          "isRun": true
        }
      ]
    },
    {
      "testCaseId": "TC-SEC-03",
      "Case": "Cross-Platform Mobile & Desktop Encrypted Password Action",
      "isRun": true,
      "hardStop": false,
      "tagNames": ["security", "mobile", "desktop", "cross-platform"],
      "testSteps": [
        {
          "steps": "Mobile (Appium) / Desktop (WinAppDriver) encrypted password typing",
          "action": "enterEncryptedPassword",
          "locatorType": "id",
          "locatorTypeValue": "txtPassword",
          "value": "{{PASSWORD}}",
          "isRun": false
        }
      ]
    }
  ]
}
