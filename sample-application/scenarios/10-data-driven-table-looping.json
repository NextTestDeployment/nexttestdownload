{
  "name": "10 Data-Driven Table Looping Suite",
  "dataFiles": [
    {
      "name": "campus-student-rows.json",
      "prefix": "student"
    }
  ],
  "testData": {
    "rows": [
      { "Index": "1", "StudentId": "2026-1001", "StudentName": "Aarav Sharma", "Status": "Active" },
      { "Index": "2", "StudentId": "2026-1002", "StudentName": "Diya Patel", "Status": "Active" },
      { "Index": "3", "StudentId": "2026-1003", "StudentName": "Kabir Verma", "Status": "Active" }
    ]
  },
  "testCases": [
    {
      "testCaseId": "1",
      "Case": "Loop Over Data Rows and Validate Parameterized Dynamic Locators",
      "isRun": true,
      "hardStop": false,
      "tagNames": ["looping", "data-driven", "table"],
      "testSteps": [
        {
          "steps": "Initialize loop counter Index to 1",
          "action": "SetModuleNumber-m:RowIndex",
          "locatorType": "NA",
          "locatorTypeValue": "NA",
          "value": "1",
          "isRun": true
        },
        {
          "steps": "Set TotalRows limit to 3",
          "action": "SetModuleNumber-m:TotalRows",
          "locatorType": "NA",
          "locatorTypeValue": "NA",
          "value": "3",
          "isRun": true
        },
        {
          "steps": "Loop Body: Validate student ID using dynamic extraction !D->RowIndex->StudentId",
          "action": "validateDataText",
          "locatorType": "NA",
          "locatorTypeValue": "NA",
          "value": "!D->RowIndex->StudentId",
          "actualValue": "!D->RowIndex->StudentId",
          "isRun": true
        },
        {
          "steps": "Increment RowIndex counter by 1",
          "action": "INCREMENTMODULENUMBER-m:RowIndex",
          "locatorType": "NA",
          "locatorTypeValue": "NA",
          "value": "1",
          "isRun": true
        },
        {
          "steps": "Conditional loop back until RowIndex exceeds TotalRows",
          "action": "GoTo",
          "locatorType": "NA",
          "locatorTypeValue": "NA",
          "value": "3",
          "condition": "m-TotalRows->>=-m-RowIndex",
          "isRun": true
        }
      ]
    }
  ]
}
